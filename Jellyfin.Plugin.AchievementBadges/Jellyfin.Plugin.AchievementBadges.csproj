<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- [issue #109] One source tree, two binaries. Jellyfin 10.11 runs on
         .NET 9 and Jellyfin 12 on .NET 10, and the 12.x Jellyfin packages
         only ship net10.0 assets, so a single DLL cannot serve both. The
         JellyfinVersion property below maps each framework to the matching
         Jellyfin package line. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jellyfin.Plugin.AchievementBadges</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.AchievementBadges</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Version>2.4.0</Version>
    <AnalysisMode>Recommended</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- v1.9.7 hardening: warnings are now build errors so future
         regressions can't ship silently. The .editorconfig at repo root
         silences the perf/style-only CA rules with documented
         justifications; correctness rules (CA1816, CA2211, CA2263)
         have been fixed at the source. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- v1.9.7 hardening: lock every transitive NuGet by hash so dotnet
         restore is reproducible across machines and CI runs. CI passes the
         locked-mode flag so any drift between the lock file and csproj
         fails fast. Closes Scorecard's Pinned Dependencies nugetCommand
         finding. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- [issue #109] Jellyfin package line per target framework. The 12.0
       line is a release candidate until Jellyfin tags 12.0.0; bump it here
       and in the Tests csproj together, they must stay identical. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <JellyfinVersion>10.11.6</JellyfinVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <JellyfinVersion>12.0.0</JellyfinVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

  </ItemGroup>


  <ItemGroup>
    <!-- Microsoft.NET.Sdk.Web implicitly classifies JSON / CSS under Pages\ as
         Content (via StaticWebAssets). Strip that first so the EmbeddedResource
         glob below is the sole owner. -->
    <Content Remove="Pages\**\*.json" />
    <None Remove="Pages\**\*.json" />
    <Content Remove="Pages\**\*.css" />
    <None Remove="Pages\**\*.css" />
    <EmbeddedResource Include="Pages\**\*" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <!-- Files matching *.<culture>.<ext> like badges.fr.json get pulled into
       culture-satellite assemblies (fr/Jellyfin.Plugin.AchievementBadges.
       resources.dll etc.) instead of the main DLL — that means
       BadgeLocalizer's `assembly.GetManifestResourceStream(...)` call on
       the main assembly returns null for every non-English language.
       Opt out of the satellite-assembly path by setting WithCulture=false
       and pinning LogicalName so each file keeps a unique resource name. -->
  <ItemGroup>
    <EmbeddedResource Update="Pages\translations\badges.en.json" WithCulture="false" LogicalName="Jellyfin.Plugin.AchievementBadges.Pages.translations.badges.en.json" />
    <EmbeddedResource Update="Pages\translations\badges.fr.json" WithCulture="false" LogicalName="Jellyfin.Plugin.AchievementBadges.Pages.translations.badges.fr.json" />
    <EmbeddedResource Update="Pages\translations\badges.es.json" WithCulture="false" LogicalName="Jellyfin.Plugin.AchievementBadges.Pages.translations.badges.es.json" />
    <EmbeddedResource Update="Pages\translations\badges.de.json" WithCulture="false" LogicalName="Jellyfin.Plugin.AchievementBadges.Pages.translations.badges.de.json" />
    <EmbeddedResource Update="Pages\translations\badges.it.json" WithCulture="false" LogicalName="Jellyfin.Plugin.AchievementBadges.Pages.translations.badges.it.json" />
    <EmbeddedResource Update="Pages\translations\badges.pt.json" WithCulture="false" LogicalName="Jellyfin.Plugin.AchievementBadges.Pages.translations.badges.pt.json" />
    <EmbeddedResource Update="Pages\translations\badges.zh.json" WithCulture="false" LogicalName="Jellyfin.Plugin.AchievementBadges.Pages.translations.badges.zh.json" />
    <EmbeddedResource Update="Pages\translations\badges.ja.json" WithCulture="false" LogicalName="Jellyfin.Plugin.AchievementBadges.Pages.translations.badges.ja.json" />
  </ItemGroup>

</Project>
